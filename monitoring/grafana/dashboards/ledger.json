{
  "title": "Ledger",
  "uid": "ledger-overview",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Posting outcomes",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ledger-prom" },
          "expr": "sum by (outcome) (rate(ledger_postings_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Posting commit latency p95",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ledger-prom" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ledger_posting_commit_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Serialization retries",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ledger-prom" },
          "expr": "ledger_posting_retries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "ledger-prom" },
          "expr": "ledger_posting_retries_exhausted"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP 5xx rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ledger-prom" },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Hikari active connections",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ledger-prom" },
          "expr": "hikaricp_connections_active"
        }
      ]
    },
    {
      "id": 6,
      "title": "Readiness",
      "type": "stat",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ledger-prom" },
          "expr": "up{job=\"ledger\"}"
        }
      ]
    }
  ]
}
