# Java / Gradle build output
build/
.gradle/
out/

# Gradle wrapper jar is COMMITTED on purpose (reproducible build without mise).
# Uncomment the next line only if you deliberately want wrapper-less builds.
# gradle/wrapper/gradle-wrapper.jar

# Compiled class files
*.class

# Jar / war / ear
*.jar
*.war
*.ear

# Exception: the Gradle wrapper jar is COMMITTED on purpose
# (reproducible build without mise or a system Gradle).
!gradle/wrapper/gradle-wrapper.jar

# No Node in this project; ignore a stale undeletable empty dir explicitly.
node_modules/

# Test / coverage reports
TestResults/

# Logs
*.log
crash.log
crash.*.log

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
*.iml
.vscode/
*.lscache

# Eclipse JDT language server (jdtls) project files and output
.classpath
.project
.settings/
bin/

# Environment variables (user-owned local state, never committed)
.env
.env.*
!.env.example

# Local secrets/config
secrets.json

# Local database backups (dumps land here; never committed)
backups/

# Private interview prep (answers stay on this machine)
docs/INTERVIEW.md
