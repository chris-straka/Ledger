# Copy to .env and fill in. .env is gitignored; this file is not.
#   cp .env.example .env
#
# Development-only credentials for the local Compose Postgres and app role.
# Never put real secrets here.

POSTGRES_DB=ledger
POSTGRES_OWNER=ledger_owner
POSTGRES_OWNER_PASSWORD=ledger_owner_dev_only
POSTGRES_APP=ledger_app
POSTGRES_APP_PASSWORD=ledger_app_dev_only
